# Server Port
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=qr_review

# JWT Security
JWT_SECRET=your_jwt_secret_key_here

# Mailer Configuration (for notifications/reminders)
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_app_password_here

# OpenAI API Key for AI reviews
OPENAI_API_KEY=your_openai_api_key_here

# Allowed CORS client URLs (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,https://your-production-frontend-domain.com
